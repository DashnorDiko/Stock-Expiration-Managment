generator client {
  provider   = "prisma-client"
  output     = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  staffCode String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  batches   Batch[]   @relation("BatchCreatedBy")
  clears    Batch[]   @relation("BatchClearedBy")
  wasteLogs WasteLog[]
}

enum ProductCategory {
  DAIRY
  CANNED
  MEAT
  PRODUCE
  FROZEN
  BAKERY
  BEVERAGE
  HOUSEHOLD
  OTHER
}

enum BatchStatus {
  ACTIVE
  CLEARED
  ARCHIVED
}

model Product {
  id        String          @id @default(cuid())
  barcode   String          @unique
  sku       String?
  name      String
  category  ProductCategory
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  batches   Batch[]
}

model Batch {
  id               String      @id @default(cuid())
  productId        String
  expirationDate   DateTime
  entryDate        DateTime    @default(now())
  locationNote     String?
  quantityEstimate Int?
  status           BatchStatus @default(ACTIVE)
  archivedAt       DateTime?
  clearedAt        DateTime?
  clearReason      String?
  createdById      String?
  clearedById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy        User?       @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  clearedBy        User?       @relation("BatchClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)
  wasteLogs        WasteLog[]

  @@index([status, expirationDate])
  @@index([productId, status])
  @@index([expirationDate])
}

model WasteLog {
  id             String   @id @default(cuid())
  batchId        String
  discardedUnits Int?
  note           String?
  loggedById     String?
  loggedAt       DateTime @default(now())
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  loggedBy       User?    @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@index([batchId, loggedAt])
}
